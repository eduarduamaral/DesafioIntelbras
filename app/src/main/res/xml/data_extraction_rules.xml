<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup na nuvem e transferência entre aparelhos (Android 12+).
   O banco local fica de fora: ele guarda as senhas dos dispositivos em texto puro
   (a API devolve assim). Os dados se recuperam com uma sincronização.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
